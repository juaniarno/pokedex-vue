# Configuración de la app web de Firebase
# (Consola de Firebase > Configuración del proyecto > Tus apps > App web > SDK setup)
# Estos valores son públicos; NO son la API key de Gemini (esa la administra Firebase).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional: modelo de Gemini a usar (por defecto gemini-3.5-flash-lite)
VITE_GEMINI_MODEL=
